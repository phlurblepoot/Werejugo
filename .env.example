# ---------------------------------------------------------------------------
# Werejugo — environment configuration
# Copy this file to `.env` and adjust before running `docker compose up`.
# ---------------------------------------------------------------------------

# --- Database ---
POSTGRES_USER=werejugo
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=werejugo
# Host/port are fixed inside the compose network; only change if you know why.
DATABASE_URL=postgres://werejugo:change-me-in-production@db:5432/werejugo

# --- Backend ---
# Secret used to sign login tokens. REQUIRED: at least 32 characters. The
# backend refuses to start in production with a missing or placeholder value.
# Generate one with:  openssl rand -hex 32
JWT_SECRET=
# Optional separate secret for signed photo/document links (derived from
# JWT_SECRET when blank).
FILE_SIGNING_SECRET=
# Encrypts the Immich keys Werejugo stores (and, later, document files).
# Needed to connect Immich. At least 32 characters; keep a copy somewhere safe.
# Generate one with:  openssl rand -hex 32
ENCRYPTION_KEY=
# Token lifetime.
JWT_EXPIRES_IN=30d
# Port the backend listens on (inside the container). Not published to the host
# by default — the frontend's nginx proxy reaches it over the compose network.
BACKEND_PORT=4000
# CORS only matters if you publish the backend and call it from another origin.
# In the default single-origin setup (nginx proxies /api) this is unused.
CORS_ORIGIN=http://localhost:8080

# --- File locations (only for running the backend outside Docker) ---
# In Docker these are fixed at /app/storage and /app/uploads and must be
# mounted as volumes (docker-compose.yml does this).
# STORAGE_DIR=/path/to/werejugo/storage   # document files
# UPLOADS_DIR=/path/to/werejugo/uploads   # custom pin icons; photos/videos while they upload

# The largest single photo or video that can be uploaded, in GB (default 20).
# MAX_UPLOAD_GB=20

# --- Optional: flight number lookup ---
# If set, flight *numbers* can be resolved to routes via AeroDataBox (RapidAPI).
# Leave blank to use manual origin/destination entry only (great-circle arcs).
AERODATABOX_RAPIDAPI_KEY=

# --- Optional: geocoding fallback for ports/places not in the bundled dataset ---
# Uses OpenStreetMap Nominatim. Be respectful of their usage policy.
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=Werejugo/0.1 (self-hosted family map)

# --- Cruise lookup ---
# Best-effort scraping of CruiseMapper. Disable if you prefer manual port entry only.
CRUISE_LOOKUP_ENABLED=true

# --- Frontend (build-time) ---
# Leave blank for the default single-origin setup (nginx proxies /api to the
# backend). Only set this if you intentionally host the API on a separate origin.
VITE_API_URL=
# Default vector map style (no API key required with OpenFreeMap).
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# The one port you expose. Open http://<server-ip>:8080 to use the app.
FRONTEND_PORT=8080
