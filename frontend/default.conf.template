# Rendered at container start by nginx's envsubst entrypoint. BACKEND_HOST and
# BACKEND_PORT come from the environment (defaults: backend / 4000), so the
# backend container can be named anything and reached over a shared network.
server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  # Icon / overlay uploads and the older single-request photo upload (backend caps at 25 MB).
  client_max_body_size 30m;

  # Security headers for the app itself. `always` so they're sent on errors too.
  # CSP: scripts only from this origin (the build has no inline scripts); styles
  # allow inline because React style attributes are used throughout; images,
  # map tiles/styles and fonts may come from any HTTPS host (the map style URL
  # is configurable); MapLibre runs its workers from blob: URLs.
  add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; connect-src 'self' https:; font-src 'self' data: https:; worker-src 'self' blob:; child-src 'self' blob:; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "SAMEORIGIN" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  add_header Permissions-Policy "camera=(), microphone=(), geolocation=(self)" always;

  # Backup download: can be large and slow to build — stream it, don't buffer.
  location = /api/backup {
    resolver 127.0.0.11 valid=30s;
    set $backup_upstream http://${BACKEND_HOST}:${BACKEND_PORT};
    proxy_pass $backup_upstream$request_uri;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_buffering off;
    proxy_read_timeout 3600s;
  }

  # A family's "download our data" archive: streamed like the backup.
  location = /api/family/export {
    resolver 127.0.0.11 valid=30s;
    set $export_upstream http://${BACKEND_HOST}:${BACKEND_PORT};
    proxy_pass $export_upstream$request_uri;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_buffering off;
    proxy_read_timeout 3600s;
  }

  # Restore upload: no size cap here (the backend allows 2 GB), streamed
  # straight through, with time to unpack. Behind Cloudflare's free plan
  # uploads over 100 MB are refused before they reach us — restore large
  # archives from the LAN address instead.
  location = /api/restore {
    resolver 127.0.0.11 valid=30s;
    set $restore_upstream http://${BACKEND_HOST}:${BACKEND_PORT};
    proxy_pass $restore_upstream$request_uri;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    client_max_body_size 0;
    proxy_request_buffering off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
  }

  # Photo and video uploads arrive in 8 MB pieces (the backend takes up to 32 MB
  # each), streamed straight through so progress is real and nothing is
  # buffered to disk here.
  location ^~ /api/media/uploads/ {
    resolver 127.0.0.11 valid=30s;
    set $media_upload_upstream http://${BACKEND_HOST}:${BACKEND_PORT};
    proxy_pass $media_upload_upstream$request_uri;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    client_max_body_size 40m;
    proxy_request_buffering off;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
  }

  # Reverse-proxy the API. Using a variable + Docker's embedded DNS resolver
  # (127.0.0.11) means nginx tolerates the backend starting later or moving IP.
  location ^~ /api/ {
    resolver 127.0.0.11 valid=30s;
    set $api_upstream http://${BACKEND_HOST}:${BACKEND_PORT};
    proxy_pass $api_upstream$request_uri;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # User-uploaded media is served by the backend.
  location ^~ /uploads/ {
    resolver 127.0.0.11 valid=30s;
    set $uploads_upstream http://${BACKEND_HOST}:${BACKEND_PORT};
    proxy_pass $uploads_upstream$request_uri;
    proxy_set_header Host $host;
  }

  # SPA fallback.
  location / {
    try_files $uri $uri/ /index.html;
  }

  # Hashed build assets. (add_header here would replace the server-level
  # security headers, so repeat them.)
  location ~* \.(js|css|png|jpg|jpeg|gif|svg|woff2?)$ {
    expires 7d;
    add_header Cache-Control "public";
    add_header X-Content-Type-Options "nosniff" always;
  }
}
